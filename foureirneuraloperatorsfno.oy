# ============================================================================
# 1. NUMERICS — a band-limited periodic operator, resolvable at ANY grid size
# ============================================================================

@dataclass
class Sample:
    a: np.ndarray   # input coefficient field
    u: np.ndarray   # target solution field


class SyntheticOperator:
    """
    u = L(a) + 0.15 * L2(a * a),   L = (1 + 0.12 * |k|^2)^-1

    Coefficients are generated in a fixed integer wavenumber band, so sampling
    the SAME continuous function at N=32, 64 or 128 is exact. This makes the
    resolution-invariance demonstration genuine.
    """

    def __init__(self, kmax: int = 8):
        self.kmax = kmax

    def sample(self, seed: int, n: int) -> Sample:
        rng = np.random.default_rng(seed)
        ks = np.fft.fftfreq(n, d=1.0 / n).astype(int)
        KX, KY = np.meshgrid(ks, ks)
        K2 = KX ** 2 + KY ** 2

        ah = np.zeros((n, n), dtype=complex)
        for kx in range(-self.kmax, self.kmax + 1):
            for ky in range(-self.kmax, self.kmax + 1):
                if kx == 0 and ky == 0:
                    continue
                c = (rng.normal() + 1j * rng.normal()) / (1 + np.hypot(kx, ky)) ** 1.6
                ah[kx % n, ky % n] += c

        a = np.fft.ifft2(ah).real
        a = (a - a.mean()) / (a.std() + 1e-8)

        u = np.fft.ifft2(np.fft.fft2(a) / (1 + 0.12 * K2)).real
        u += 0.15 * np.fft.ifft2(np.fft.fft2(a * a) / (1 + 0.20 * K2)).real
        u = (u - u.mean()) / (u.std() + 1e-8)
        return Sample(a, u)


def mock_predict(a: np.ndarray, keep: int) -> np.ndarray:
    """Demo 'model': learns only the linear part, with a hard mode cutoff."""
    n = a.shape[0]
    ks = np.fft.fftfreq(n, d=1.0 / n).astype(int)
    KX, KY = np.meshgrid(ks, ks)
    mask = (np.abs(KX) <= keep) & (np.abs(KY) <= keep)
    uh = np.fft.fft2(a) / (1 + 0.12 * (KX ** 2 + KY ** 2)) * mask
    return np.fft.ifft2(uh).real


def mode_mask(n: int, keep: int) -> np.ndarray:
    ks = np.fft.fftfreq(n, d=1.0 / n).astype(int)
    KX, KY = np.meshgrid(ks, ks)
    return (np.abs(KX) <= keep) & (np.abs(KY) <= keep)


def metrics(u: np.ndarray, p: np.ndarray, keep: int) -> dict[str, float]:
    err = u - p
    mse = float(np.mean(err ** 2))
    uh = np.fft.fft2(u)
    mask = mode_mask(u.shape[0], keep)
    energy = float(np.sum(np.abs(uh[mask]) ** 2) / (np.sum(np.abs(uh) ** 2) + 1e-12))
    return {
        "L1": float(np.mean(np.abs(err))),
        "L2": float(np.sqrt(mse)),
        "Rel L2": float(np.linalg.norm(err) / (np.linalg.norm(u) + 1e-12)),
        "Max": float(np.max(np.abs(err))),
        "PSNR": float(10 * np.log10((np.ptp(u) ** 2) / (mse + 1e-12))),
        "Energy": energy,
    }


# ============================================================================
# 2. REAL FNO (optional backend)
# ============================================================================

if HAS_TORCH:

    class SpectralConv2d(nn.Module):
        """Multiplication by a learnable complex kernel on the lowest modes."""

        def __init__(self, width: int, modes: int):
            super().__init__()
            self.modes = modes
            scale = 1.0 / (width * width)
            shape = (width, width, modes, modes + 1)
            self.w1 = nn.Parameter(scale * torch.rand(shape, dtype=torch.cfloat))
            self.w2 = nn.Parameter(scale * torch.rand(shape, dtype=torch.cfloat))

        def forward(self, x: torch.Tensor) -> torch.Tensor:
            b, _, h, w = x.shape
            xf = torch.fft.rfft2(x)
            of = torch.zeros(
                b, self.w1.shape[1], h, w // 2 + 1,
                dtype=torch.cfloat, device=x.device,
            )
            # non-negative ky branch
            of[:, :, :self.modes, :self.modes + 1] = torch.einsum(
                "bixy,ioxy->boxy", xf[:, :, :self.modes, :self.modes + 1], self.w1
            )
            # negative ky branch
            of[:, :, -self.modes:, :self.modes + 1] = torch.einsum(
                "bixy,ioxy->boxy", xf[:, :, -self.modes:, :self.modes + 1], self.w2
            )
            return torch.fft.irfft2(of, s=(h, w))

    class FNO2d(nn.Module):
        def __init__(self, width: int = 16, modes: int = 8, layers: int = 4):
            super().__init__()
            self.width, self.modes, self.n_layers = width, modes, layers
            self.lift = nn.Conv2d(3, width, 1)
            self.spectral = nn.ModuleList(
                [SpectralConv2d(width, modes) for _ in range(layers)]
            )
            self.skips = nn.ModuleList(
                [nn.Conv2d(width, width, 1) for _ in range(layers)]
            )
            self.proj1 = nn.Conv2d(width, width, 1)
            self.proj2 = nn.Conv2d(width, 1, 1)

        def forward(self, x: torch.Tensor) -> torch.Tensor:
            x = self.lift(x)
            for sp, sk in zip(self.spectral, self.skips):
                x = F.gelu(sp(x) + sk(x))
            x = F.gelu(self.proj1(x))
            return self.proj2(x)

    def prune_modes(model: "FNO2d", keep: int) -> "FNO2d":
        """Return a copy whose spectral kernels only retain |kx|,|ky| <= keep."""
        m = copy.deepcopy(model).eval()
        with torch.no_grad():
            for layer in m.spectral:
                M = layer.modes
                layer.w1[:, :, min(keep + 1, M):, :] = 0
                layer.w1[:, :, :, keep + 1:] = 0
                layer.w2[:, :, :M - keep, :] = 0
                layer.w2[:, :, :, keep + 1:] = 0
        return m

    def make_input(a: np.ndarray) -> torch.Tensor:
        """Append (x, y) coordinate channels, matching training conventions."""
        n = a.shape[-1]
        g = np.linspace(0, 1, n, endpoint=False)
        X, Y = np.meshgrid(g, g)
        coords = torch.from_numpy(np.stack([X, Y])[None]).float()
        return torch.cat([torch.from_numpy(a).float(), coords], dim=1).unsqueeze(0)


class TrainingWorker(QThread):
    progress = Signal(int, float, float)
    snapshot = Signal(object)
    log = Signal(str)
    done = Signal(str)

    def __init__(self, cfg: dict, op: SyntheticOperator):
        super().__init__()
        self.cfg = dict(cfg)
        self.op = op
        self._stop = False

    def request_stop(self):
        self._stop = True

    def _dataset(self, seed: int, count: int, n: int, device: str):
        aa, uu = [], []
        for i in range(count):
            s = self.op.sample(seed + i, n)
            aa.append(s.a)
            uu.append(s.u)
        a = torch.from_numpy(np.stack(aa)[:, None]).float()
        u = torch.from_numpy(np.stack(uu)[:, None]).float()
        g = np.linspace(0, 1, n, endpoint=False)
        X, Y = np.meshgrid(g, g)
        coords = torch.from_numpy(np.stack([X, Y])[None]).float().expand(count, 2, n, n)
        x = torch.cat([a, coords], dim=1).to(device)
        return x, u.to(device)

    def run(self):
        try:
            c = self.cfg
            dev = c["device"]
            if dev in ("Auto", "CUDA"):
                device = "cuda" if torch.cuda.is_available() else "cpu"
            else:
                device = "cpu"
            torch.manual_seed(c["seed"])

            model = FNO2d(c["width"], c["modes"], c["layers"]).to(device)
            model._fno_cfg = {k: c[k] for k in ("width", "modes", "layers")}
            self.snapshot.emit(copy.deepcopy(model).cpu().eval())
            self.log.emit(f"Device: {device} | width={c['width']} modes={c['modes']} "
                          f"layers={c['layers']} train_N={c['train_n']}")

            xtr, ytr = self._dataset(1000, c["train_size"], c["train_n"], device)
            xva, yva = self._dataset(9000, c["val_size"], c["train_n"], device)

            opt = torch.optim.Adam(model.parameters(), lr=c["lr"], weight_decay=1e-5)
            sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=c["epochs"])
            best, best_model = float("inf"), None

            for epoch in range(1, c["epochs"] + 1):
                if self._stop:
                    break
                model.train()
                perm = torch.randperm(xtr.shape[0], device=device)
                total = 0.0
                for start in range(0, xtr.shape[0], c["batch"]):
                    if self._stop:
                        break
                    idx = perm[start:start + c["batch"]]
                    loss = F.mse_loss(model(xtr[idx]), ytr[idx])
                    opt.zero_grad(set_to_none=True)
                    loss.backward()
                    opt.step()
                    total += loss.item() * idx.numel()
                train_loss = total / xtr.shape[0]

                model.eval()
                with torch.no_grad():
                    val_loss = F.mse_loss(model(xva), yva).item()
                sched.step()

                self.progress.emit(epoch, train_loss, val_loss)
                if val_loss < best:
                    best = val_loss
                    best_model = copy.deepcopy(model).cpu().eval()
                if epoch % 2 == 0 or epoch == c["epochs"]:
                    self.snapshot.emit(copy.deepcopy(model).cpu().eval())
                if epoch % 5 == 0 or epoch == 1:
                    self.log.emit(f"epoch {epoch:3d}  train={train_loss:.5f}  "
                                  f"val={val_loss:.5f}  best={best:.5f}")

            if best_model is not None:
                best_model._fno_cfg = model._fno_cfg
                self.snapshot.emit(best_model)
                self.log.emit(f"Restored best checkpoint (val MSE = {best:.6f})")
            self.done.emit("stopped" if self._stop else "complete")
        except Exception as exc:
            self.log.emit(f"Training error: {exc}")
            self.done.emit("failed")


# ============================================================================
# 3. MATPLOTLIB PANELS
# ============================================================================

def style_figure(fig: Figure, dark: bool):
    bg = "#1e1f22" if dark else "#ffffff"
    fg = "#e6e6e6" if dark else "#202124"
    grid = "#3a3d42" if dark else "#dcdcdc"
    fig.set_facecolor(bg)
    for ax in fig.axes:
        ax.set_facecolor(bg)
        ax.tick_params(colors=fg, labelsize=8)
        ax.title.set_color(fg)
        ax.xaxis.label.set_color(fg)
        ax.yaxis.label.set_color(fg)
        for spine in ax.spines.values():
            spine.set_color(grid)
        ax.grid(color=grid, lw=0.5, alpha=0.6)


class BaseCanvas(FigureCanvas):
    def __init__(self, figsize=(5, 4)):
        self.fig = Figure(figsize=figsize, dpi=100, constrained_layout=True)
        super().__init__(self.fig)
        self.setMinimumHeight(140)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)

    def restyle(self, dark: bool):
        style_figure(self.fig, dark)
        self.draw_idle()


class FieldCanvas(BaseCanvas):
    def __init__(self):
        super().__init__((7, 7))
        self.quad = False
        self._build(False)

    def _build(self, quad: bool):
        self.fig.clear()
        self.quad = quad
        self.axes = (list(self.fig.subplots(2, 2).ravel()) if quad
                     else [self.fig.add_subplot(111)])
        self.images, self.bars, self.cross = [], [], []
        for ax in self.axes:
            im = ax.imshow(np.zeros((2, 2)), cmap="viridis", origin="lower",
                           extent=[0, 1, 0, 1])
            self.images.append(im)
            self.bars.append(self.fig.colorbar(im, ax=ax, fraction=0.046, pad=0.04))
            vx = ax.axvline(0.5, color="white", lw=0.9, ls=":")
            hy = ax.axhline(0.5, color="white", lw=0.9, ls=":")
            vx.set_visible(False)
            hy.set_visible(False)
            self.cross.append((vx, hy))
            ax.set_xlabel("x")
            ax.set_ylabel("y")

    def set_quad(self, quad: bool, dark: bool):
        if quad != self.quad:
            self._build(quad)
            style_figure(self.fig, dark)

    def paint(self, fields, titles, cmaps, cursor, n):
        for i, (ax, im) in enumerate(zip(self.axes, self.images)):
            data = fields[i]
            im.set_data(data)
            im.set_cmap(cmaps[i])
            im.set_clim(data.min(), data.max())
            ax.set_title(titles[i], fontweight="bold")
            self.bars[i].update_normal(im)
            vx, hy = self.cross[i]
            visible = cursor is not None
            vx.set_visible(visible)
            hy.set_visible(visible)
            if visible:
                col, row = cursor
                vx.set_xdata([(col + 0.5) / n, (col + 0.5) / n])
                hy.set_ydata([(row + 0.5) / n, (row + 0.5) / n])
        self.draw_idle()


class SliceCanvas(BaseCanvas):
    def __init__(self):
        super().__init__((7, 3))
        self.axes = self.fig.subplots(1, 2)
        self.lines = []
        for ax in self.axes:
            ls = [ax.plot([], [], label=t, **kw)[0] for t, kw in [
                ("input", dict(color="#4dabf7", lw=1.2, alpha=0.8)),
                ("truth", dict(color="#51cf66", lw=2.0)),
                ("prediction", dict(color="#ff6b6b", lw=1.6, ls="--")),
            ]]
            self.lines.append(ls)
            ax.legend(fontsize=7, loc="best")
            ax.grid(True, alpha=0.3)

    def paint(self, sample: Sample, pred: np.ndarray, cursor):
        n = sample.a.shape[0]
        t = np.linspace(0, 1, n, endpoint=False)
        row = n // 2 if cursor is None else cursor[1]
        col = n // 2 if cursor is None else cursor[0]
        slices = [
            (t, [sample.a[row, :], sample.u[row, :], pred[row, :]], f"Horizontal slice  y={t[row]:.3f}"),
            (t, [sample.a[:, col], sample.u[:, col], pred[:, col]], f"Vertical slice  x={t[col]:.3f}"),
        ]
        for ax, lines, (xs, ys, title) in zip(self.axes, self.lines, slices):
            for line, y in zip(lines, ys):
                line.set_data(xs, y)
            all_y = np.concatenate(ys)
            pad = (all_y.max() - all_y.min()) * 0.12 + 1e-6
            ax.set_ylim(all_y.min() - pad, all_y.max() + pad)
            ax.set_title(title, fontsize=9)
            ax.set_xlabel("coordinate")
        self.draw_idle()


class SpectrumCanvas(BaseCanvas):
    def __init__(self):
        super().__init__((5, 4))
        self.ax = self.fig.add_subplot(111)
        self.im = self.ax.imshow(np.zeros((2, 2)), cmap="magma", origin="lower")
        self.bar = self.fig.colorbar(self.im, ax=self.ax, fraction=0.046, pad=0.04)
        self.box = Rectangle((0, 0), 1, 1, fill=False, edgecolor="#63e6be", lw=1.6)
        self.ax.add_patch(self.box)
        self.ax.set_title("Fourier spectrum", fontweight="bold")

    def paint(self, field: np.ndarray, keep: int, component: str, logscale: bool):
        F = np.fft.fftshift(np.fft.fft2(field))
        if component == "Phase":
            data, cmap, clim = np.angle(F), "hsv", (-np.pi, np.pi)
        else:
            data = {"Amplitude": np.abs(F), "Real": F.real, "Imag": F.imag}[component]
            if logscale and component == "Amplitude":
                data = np.log1p(data)
            cmap = "magma"
            clim = (data.min(), data.max())
        self.im.set_data(data)
        self.im.set_cmap(cmap)
        self.im.set_clim(*clim)
        self.bar.update_normal(self.im)

        n = field.shape[0]
        c = n / 2
        self.box.set_xy((c - keep - 0.5, c - keep - 0.5))
        self.box.set_width(2 * keep + 1)
        self.box.set_height(2 * keep + 1)
        self.ax.set_title(f"Spectrum — retained |k| ≤ {keep}", fontweight="bold")
        self.draw_idle()


class HistCanvas(BaseCanvas):
    def __init__(self):
        super().__init__((5, 3))
        self.ax = self.fig.add_subplot(111)
        self.ax.set_title("Pointwise error distribution", fontweight="bold")
        self.ax.set_xlabel("|error|")
        self.ax.set_ylabel("count")

    def paint(self, error: np.ndarray):
        self.ax.clear()
        self.ax.hist(error.ravel(), bins=40, color="#ffa94d", edgecolor="none", alpha=0.85)
        self.ax.axvline(np.mean(error), color="#ff6b6b", lw=1.5, label="mean")
        self.ax.set_title("Pointwise error distribution", fontweight="bold")
        self.ax.set_xlabel("|error|")
        self.ax.set_ylabel("count")
        self.ax.legend(fontsize=8)
        self.draw_idle()


class LossCanvas(BaseCanvas):
    def __init__(self):
        super().__init__((4, 2.4))
        self.ax = self.fig.add_subplot(111)
        self.ax.set_yscale("log")
        self.ax.set_xlabel("epoch")
        self.ax.set_ylabel("MSE")
        self.ax.set_title("Training loss", fontweight="bold")
        self.ax.grid(True, alpha=0.3)
        self.lt, = self.ax.plot([], [], label="train", color="#4dabf7")
        self.lv, = self.ax.plot([], [], label="val", color="#51cf66")
        self.ax.legend(fontsize=8)

    def paint(self, history):
        if not history:
            return
        ep, tr, va = zip(*history)
        self.lt.set_data(ep, tr)
        self.lv.set_data(ep, va)
        self.ax.relim()
        self.ax.autoscale_view()
        self.draw_idle()


class KernelCanvas(BaseCanvas):
    def __init__(self):
        super().__init__((4, 3.4))
        self.ax = self.fig.add_subplot(111)
        self.im = self.ax.imshow(np.zeros((2, 2)), cmap="viridis", origin="lower")
        self.bar = self.fig.colorbar(self.im, ax=self.ax, fraction=0.046, pad=0.04)
        self.box = Rectangle((0, 0), 1, 1, fill=False, edgecolor="#63e6be", lw=1.6)
        self.ax.add_patch(self.box)
        self.ax.set_xlabel("kx  (rfft mode)")
        self.ax.set_ylabel("ky  (centered)")

    def paint(self, kernel: np.ndarray, M: int, keep: int, title: str, phase: bool):
        self.im.set_data(kernel)
        self.im.set_cmap("hsv" if phase else "viridis")
        self.im.set_clim((-np.pi, np.pi) if phase else (kernel.min(), kernel.max()))
        self.bar.update_normal(self.im)
        self.box.set_xy((-0.5, M - keep - 0.5))
        self.box.set_width(keep + 1)
        self.box.set_height(2 * keep + 1)
        self.ax.set_title(title, fontweight="bold", fontsize=9)
        self.draw_idle()


