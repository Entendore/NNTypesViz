class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("FNO Studio — Fourier Neural Operator Workbench")
        self.resize(1560, 940)

        self.settings = QSettings("FNOStudio", "FNOStudio")
        self.dark = self.settings.value("dark", False, type=bool)
        self.op = SyntheticOperator()
        self.model = None
        self.model_cfg = None
        self.sample_index = int(self.settings.value("sample", 7))
        self.resolution = int(self.settings.value("resolution", 64))
        self.keep = int(self.settings.value("keep", 6))
        self.cursor = None
        self.history: list[tuple[int, float, float]] = []
        self.worker: TrainingWorker | None = None
        self._closing = False

        self._cache: dict[tuple, tuple[Sample, np.ndarray]] = {}
        self._prune_cache: dict[tuple, object] = {}

        self._refresh_timer = QTimer(self)
        self._refresh_timer.setSingleShot(True)
        self._refresh_timer.setInterval(60)
        self._refresh_timer.timeout.connect(self.refresh)

        self._sweep_timer = QTimer(self)
        self._sweep_timer.setInterval(280)
        self._sweep_timer.timeout.connect(self._sweep_step)
        self._sweep_dir = 1

        self._build_ui()
        self._build_actions()
        self._apply_theme()
        self._load_settings()
        self.refresh()

        if not HAS_TORCH:
            self.log.append("[demo] PyTorch not found — running synthetic operator demo.")
            self.log.append("[demo] pip install torch to enable real FNO training.")
        else:
            self.log.append(f"[torch] {torch.__version__} | "
                            f"CUDA available: {torch.cuda.is_available()}")

    # ------------------------------------------------------------------ UI

    def _build_ui(self):
        central = QWidget()
        outer = QVBoxLayout(central)
        outer.setContentsMargins(8, 8, 8, 8)

        self.splitter = QSplitter(Qt.Orientation.Horizontal)
        self.splitter.addWidget(self._left_panel())
        self.splitter.addWidget(self._center_panel())
        self.splitter.addWidget(self._right_panel())
        self.splitter.setSizes([285, 780, 380])
        outer.addWidget(self.splitter)
        self.setCentralWidget(central)

        self.setStatusBar(QStatusBar())
        self.statusBar().showMessage("Ready")

        tb = self.addToolBar("Main")
        tb.setMovable(False)
        tb.setIconSize(tb.iconSize())
        for action in (self.act_sample, self.act_quad, self.act_sweep,
                       self.act_png, self.act_theme):
            tb.addAction(action)

    def _scroll(self, widget) -> QScrollArea:
        area = QScrollArea()
        area.setWidgetResizable(True)
        area.setFrameShape(QScrollArea.Shape.NoFrame)
        area.setWidget(widget)
        return area

    def _left_panel(self) -> QWidget:
        w = QWidget()
        lay = QVBoxLayout(w)
        lay.setSpacing(10)

        # Dataset
        g = QGroupBox("1 · Dataset")
        f = QFormLayout(g)
        self.spin_sample = QSpinBox()
        self.spin_sample.setRange(0, 9999)
        self.spin_sample.valueChanged.connect(self._on_sample_changed)
        self.cmb_resolution = QComboBox()
        self.cmb_resolution.addItems(["32", "64", "128"])
        self.cmb_resolution.currentTextChanged.connect(self._on_resolution_changed)
        self.cmb_resolution.setToolTip(
            "Evaluate on a finer grid. The operator is band-limited, so this is a "
            "genuine zero-shot resolution-transfer test for a trained FNO."
        )
        btn_random = QPushButton("Random sample")
        btn_random.setObjectName("secondary")
        btn_random.clicked.connect(lambda: self.spin_sample.setValue(
            int(np.random.default_rng().integers(0, 9999))))
        f.addRow("Sample seed", self.spin_sample)
        f.addRow("Eval grid", self.cmb_resolution)
        lay.addWidget(g)
        lay.addWidget(btn_random)

        # View
        g = QGroupBox("2 · Field view")
        f = QFormLayout(g)
        self.chk_quad = QCheckBox("2 × 2 comparison")
        self.chk_quad.toggled.connect(self._on_view_changed)
        self.cmb_var = QComboBox()
        self.cmb_var.addItems(["Input a(x)", "Truth u(x)", "Prediction", "Absolute error"])
        self.cmb_var.currentIndexChanged.connect(self._schedule)
        self.cmb_cmap = QComboBox()
        self.cmb_cmap.addItems(["viridis", "plasma", "inferno", "magma", "coolwarm", "RdBu", "turbo"])
        self.cmb_cmap.currentTextChanged.connect(self._schedule)
        f.addRow(self.chk_quad)
        f.addRow("Variable", self.cmb_var)
        f.addRow("Colormap", self.cmb_cmap)
        lay.addWidget(g)

        # Truncation
        g = QGroupBox("3 · Spectral truncation")
        v = QVBoxLayout(g)
        self.lbl_keep = QLabel()
        self.slider = QSlider(Qt.Orientation.Horizontal)
        self.slider.setRange(1, 16)
        self.slider.setToolTip(
            "Zeroes out learned spectral weights outside |kx|,|ky| <= keep and "
            "re-runs the network. This is a real architectural ablation."
        )
        self.slider.valueChanged.connect(self._on_keep_changed)
        row = QHBoxLayout()
        self.btn_sweep = QPushButton("▶ Sweep")
        self.btn_sweep.setCheckable(True)
        self.btn_sweep.toggled.connect(self._toggle_sweep)
        row.addWidget(self.slider, 1)
        row.addWidget(self.btn_sweep)
        v.addWidget(self.lbl_keep)
        v.addLayout(row)
        hint = QLabel("Low modes → smooth, low-frequency solution.\n"
                      "High modes → fine detail (and learned noise).")
        hint.setWordWrap(True)
        hint.setStyleSheet("font-size:10px; opacity:0.7;")
        v.addWidget(hint)
        lay.addWidget(g)

        # Metrics
        g = QGroupBox("4 · Metrics")
        grid = QGridLayout(g)
        self.metric_labels = {}
        for i, (name, tip) in enumerate([
            ("L1", "Mean absolute error."),
            ("L2", "Root mean squared error."),
            ("Rel L2", "Relative L2 error — the standard FNO benchmark metric."),
            ("Max", "Maximum pointwise error."),
            ("PSNR", "Peak signal-to-noise ratio in dB."),
            ("Energy", "Fraction of truth spectral energy inside the retained mode box."),
        ]):
            lab = QLabel("—")
            lab.setToolTip(tip)
            grid.addWidget(QLabel(name), i, 0)
            grid.addWidget(lab, i, 1)
            self.metric_labels[name] = lab
        lay.addWidget(g)
        lay.addStretch()

        return self._scroll(w)

    def _center_panel(self) -> QWidget:
        w = QWidget()
        lay = QVBoxLayout(w)
        lay.setContentsMargins(0, 0, 0, 0)

        self.field = FieldCanvas()
        self.field.mpl_connect("button_press_event", self._on_click)

        self.bottom_tabs = QTabWidget()

        self.slices = SliceCanvas()
        self.bottom_tabs.addTab(self.slices, "Cross-sections")

        spec_widget = QWidget()
        sv = QVBoxLayout(spec_widget)
        sv.setContentsMargins(6, 6, 6, 6)
        bar = QHBoxLayout()
        self.cmb_spec_src = QComboBox()
        self.cmb_spec_src.addItems(["Prediction", "Truth", "Input"])
        self.cmb_spec_comp = QComboBox()
        self.cmb_spec_comp.addItems(["Amplitude", "Phase", "Real", "Imag"])
        self.chk_log = QCheckBox("log amplitude")
        self.chk_log.setChecked(True)
        for cb in (self.cmb_spec_src, self.cmb_spec_comp, self.chk_log):
            cb.currentIndexChanged.connect(self._schedule) if isinstance(cb, QComboBox) \
                else cb.stateChanged.connect(self._schedule)
            bar.addWidget(cb)
        self.spectrum = SpectrumCanvas()
        sv.addLayout(bar)
        sv.addWidget(self.spectrum)
        self.bottom_tabs.addTab(spec_widget, "Fourier spectrum")

        self.hist = HistCanvas()
        self.bottom_tabs.addTab(self.hist, "Error histogram")

        split = QSplitter(Qt.Orientation.Vertical)
        split.addWidget(self.field)
        split.addWidget(self.bottom_tabs)
        split.setSizes([600, 280])
        lay.addWidget(split)
        return w

    def _right_panel(self) -> QWidget:
        self.right_tabs = QTabWidget()

        # --- Training tab ---
        tw = QWidget()
        tv = QVBoxLayout(tw)
        form_widget = QWidget()
        form = QFormLayout(form_widget)

        self.spin_epochs = QSpinBox(); self.spin_epochs.setRange(1, 1000); self.spin_epochs.setValue(30)
        self.spin_width = QSpinBox(); self.spin_width.setRange(4, 64); self.spin_width.setSingleStep(4); self.spin_width.setValue(16)
        self.spin_modes = QSpinBox(); self.spin_modes.setRange(2, 16); self.spin_modes.setValue(8)
        self.spin_layers = QSpinBox(); self.spin_layers.setRange(1, 8); self.spin_layers.setValue(4)
        self.spin_train_n = QSpinBox(); self.spin_train_n.setRange(16, 64); self.spin_train_n.setSingleStep(16); self.spin_train_n.setValue(32)
        self.spin_batch = QSpinBox(); self.spin_batch.setRange(2, 64); self.spin_batch.setValue(16)
        self.spin_lr = QDoubleSpinBox(); self.spin_lr.setDecimals(5); self.spin_lr.setSingleStep(0.0001)
        self.spin_lr.setRange(0.00001, 0.01); self.spin_lr.setValue(0.001)
        self.cmb_device = QComboBox(); self.cmb_device.addItems(["Auto", "CPU", "CUDA"])

        for lab, wid in [
            ("Epochs", self.spin_epochs), ("Width", self.spin_width),
            ("Fourier modes", self.spin_modes), ("FNO layers", self.spin_layers),
            ("Train grid", self.spin_train_n), ("Batch size", self.spin_batch),
            ("Learning rate", self.spin_lr), ("Device", self.cmb_device),
        ]:
            form.addRow(lab, wid)

        self.btn_train = QPushButton("▶  Train FNO")
        self.btn_train.clicked.connect(self._start_training)
        self.btn_stop = QPushButton("■  Stop")
        self.btn_stop.setObjectName("secondary")
        self.btn_stop.clicked.connect(lambda: self.worker.request_stop() if self.worker else None)
        self.btn_stop.setEnabled(False)
        self.btn_reset = QPushButton("Reset to demo model")
        self.btn_reset.setObjectName("secondary")
        self.btn_reset.clicked.connect(self._reset_model)

        self.progress = QProgressBar()
        self.progress.setRange(0, 100)
        self.loss = LossCanvas()
        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setMaximumBlockCount(300)
        self.log.setFixedHeight(120)

        tv.addWidget(self._scroll(form_widget))
        tv.addWidget(self.btn_train)
        row = QHBoxLayout()
        row.addWidget(self.btn_stop)
        row.addWidget(self.btn_reset)
        tv.addLayout(row)
        tv.addWidget(self.progress)
        tv.addWidget(self.loss, 1)
        tv.addWidget(QLabel("Training log"))
        tv.addWidget(self.log)

        if not HAS_TORCH:
            self.btn_train.setEnabled(False)
            self.btn_train.setText("▶ Train FNO (install torch)")
            for wdg in (self.spin_epochs, self.spin_width, self.spin_modes,
                        self.spin_layers, self.spin_train_n, self.spin_batch,
                        self.spin_lr, self.cmb_device):
                wdg.setEnabled(False)

        self.right_tabs.addTab(tw, "Model & training")

        # --- Kernel inspector tab ---
        kw = QWidget()
        kv = QVBoxLayout(kw)
        kf = QFormLayout()
        self.cmb_layer = QComboBox()
        self.cmb_in = QComboBox()
        self.cmb_out = QComboBox()
        self.cmb_kernel = QComboBox()
        self.cmb_kernel.addItems(["Magnitude", "Phase"])
        for cb in (self.cmb_layer, self.cmb_in, self.cmb_out, self.cmb_kernel):
            cb.currentIndexChanged.connect(self._schedule)
        kf.addRow("Spectral layer", self.cmb_layer)
        kf.addRow("In channel", self.cmb_in)
        kf.addRow("Out channel", self.cmb_out)
        kf.addRow("Component", self.cmb_kernel)
        kv.addLayout(kf)

        self.kernel = KernelCanvas()
        kv.addWidget(self.kernel, 1)
        note = QLabel(
            "Each FNO layer learns a complex kernel R(k).\n\n"
            "The green box marks the modes retained by the truncation slider.\n"
            "Rows are centered in ky; columns are the non-negative kx half-spectrum.\n\n"
            "In demo mode an analytic reference kernel is shown instead."
        )
        note.setWordWrap(True)
        note.setStyleSheet("font-size:10px; opacity:0.75;")
        kv.addWidget(note)
        self.right_tabs.addTab(kw, "Learned kernels")

        return self.right_tabs

    # -------------------------------------------------------------- actions

    def _build_actions(self):
        def add(text, slot, shortcut=None):
            a = QAction(text, self)
            a.triggered.connect(slot)
            if shortcut:
                a.setShortcut(QKeySequence(shortcut))
            self.addAction(a)
            return a

        self.act_sample = add("New sample", lambda: self.spin_sample.setValue(
            int(np.random.default_rng().integers(0, 9999))), "R")
        self.act_quad = add("Toggle 2×2 view", lambda: self.chk_quad.toggle(), "G")
        self.act_quad.setCheckable(True)
        self.chk_quad.toggled.connect(self.act_quad.setChecked)
        self.act_sweep = add("Sweep modes", self.btn_sweep.toggle, "Space")
        self.act_sweep.setCheckable(True)
        self.btn_sweep.toggled.connect(self.act_sweep.setChecked)
        self.act_png = add("Export PNG…", self._export_png, "S")
        self.act_theme = add("Toggle theme", self._toggle_theme, "D")

        m_file = self.menuBar().addMenu("&File")
        m_file.addAction(add("Export PNG…", self._export_png, "S"))
        m_file.addAction(add("Export fields (.npz)…", self._export_npz))
        m_file.addAction(add("Export slice (.csv)…", self._export_csv))
        m_file.addSeparator()
        m_file.addAction(add("Save model weights…", self._export_model))
        m_file.addAction(add("Load model weights…", self._import_model))
        m_file.addSeparator()
        m_file.addAction(add("Quit", self.close, "Ctrl+Q"))

        m_view = self.menuBar().addMenu("&View")
        m_view.addAction(self.act_quad)
        m_view.addAction(self.act_theme)

        m_help = self.menuBar().addMenu("&Help")
        m_help.addAction(add("About FNO Studio", self._about, "F1"))

    def _load_settings(self):
        self.spin_sample.blockSignals(True)
        self.spin_sample.setValue(self.sample_index)
        self.spin_sample.blockSignals(False)
        self.cmb_resolution.setCurrentText(str(self.resolution))
        self.slider.blockSignals(True)
        self.slider.setValue(self.keep)
        self.slider.blockSignals(False)
        self.cmb_cmap.setCurrentText(self.settings.value("cmap", "viridis"))
        self.cmb_var.setCurrentIndex(int(self.settings.value("var", 2)))
        self.chk_quad.setChecked(self.settings.value("quad", False, type=bool))

    # ------------------------------------------------------------- inference

    def _predict(self, sample: Sample, keep: int) -> np.ndarray:
        if self.model is not None and HAS_TORCH:
            key = (id(self.model), keep)
            if key not in self._prune_cache:
                self._prune_cache[key] = prune_modes(self.model, keep)
            model = self._prune_cache[key]
            with torch.no_grad():
                return model(make_input(sample.a))[0, 0].cpu().numpy()
        return mock_predict(sample.a, keep)

    def _cached(self, seed: int, n: int, keep: int):
        key = (seed, n, keep, id(self.model))
        if key not in self._cache:
            sample = self.op.sample(seed, n)
            pred = self._predict(sample, keep)
            self._cache[key] = (sample, pred)
            if len(self._cache) > 24:
                self._cache.pop(next(iter(self._cache)))
        return self._cache[key]

    def _schedule(self):
        self._refresh_timer.start()

    def _on_sample_changed(self, v):
        self.sample_index = v
        self.cursor = None
        self._schedule()

    def _on_resolution_changed(self, text):
        self.resolution = int(text)
        self.cursor = None
        self._schedule()

    def _on_keep_changed(self, v):
        self.keep = v
        self._schedule()

    def _on_view_changed(self):
        self.cmb_var.setEnabled(not self.chk_quad.isChecked())
        self.field.set_quad(self.chk_quad.isChecked(), self.dark)
        self._schedule()

    def _on_click(self, event):
        if event.inaxes not in self.field.axes or event.xdata is None:
            return
        n = self.resolution
        col = int(np.clip(event.xdata * n, 0, n - 1))
        row = int(np.clip(event.ydata * n, 0, n - 1))
        self.cursor = (col, row)
        self.refresh()

    # -------------------------------------------------------------- refresh

    def refresh(self):
        if self._closing:
            return
        self.sample, self.pred = self._cached(
            self.sample_index, self.resolution, self.keep)
        u, a, p = self.sample.u, self.sample.a, self.pred
        err = np.abs(u - p)
        m = metrics(u, p, self.keep)

        for name, lab in self.metric_labels.items():
            val = m[name]
            lab.setText(f"{val * 100:.2f} %" if name == "Energy" else f"{val:.5f}")

        cmap = self.cmb_cmap.currentText()
        if self.chk_quad.isChecked():
            fields = [a, u, p, err]
            titles = ["Input a(x)", "Ground truth u(x)",
                      f"Prediction  (|k| ≤ {self.keep})", "Absolute error"]
            cmaps = [cmap, cmap, cmap, "hot"]
        else:
            idx = self.cmb_var.currentIndex()
            fields = [[a, u, p, err][idx]]
            titles = [["Input a(x)", "Ground truth u(x)",
                       f"Prediction  (|k| ≤ {self.keep})", "Absolute error"][idx]]
            cmaps = ["hot" if idx == 3 else cmap]

        n = self.resolution
        self.field.paint(fields, titles, cmaps, self.cursor, n)
        self.slices.paint(self.sample, p, self.cursor)
        self.hist.paint(err)

        src = {"Prediction": p, "Truth": u, "Input": a}[self.cmb_spec_src.currentText()]
        self.spectrum.paint(src, self.keep, self.cmb_spec_comp.currentText(),
                            self.chk_log.isChecked())
        self._paint_kernel()

        backend = "PyTorch FNO" if self.model is not None else "Synthetic demo"
        self.statusBar().showMessage(
            f"{backend}  |  grid {n}×{n}  |  modes {self.keep}  |  "
            f"rel-L2 {m['Rel L2']:.4f}  |  "
            f"cursor {self.cursor if self.cursor else '—'}"
        )

    def _paint_kernel(self):
        M = self.model.modes if self.model is not None else self.spin_modes.value()
        keep = min(self.keep, M)
        phase = self.cmb_kernel.currentText() == "Phase"

        if self.model is not None and HAS_TORCH:
            li = self.cmb_layer.currentIndex()
            ic = self.cmb_in.currentIndex()
            oc = self.cmb_out.currentIndex()
            layer = self.model.spectral[max(li, 0)]
            w1 = layer.w1.detach().cpu().numpy()[ic, oc]
            w2 = layer.w2.detach().cpu().numpy()[ic, oc]
            kernel = np.concatenate([w2, w1], axis=0)
            kernel = np.angle(kernel) if phase else np.abs(kernel)
            title = f"Layer {li} · {ic} → {oc} · {'phase' if phase else '|weight|'}"
        else:
            ky = np.arange(-M, M)
            kx = np.arange(0, M + 1)
            KX, KY = np.meshgrid(kx, ky)
            kernel = 1.0 / (1 + 0.12 * (KX ** 2 + KY ** 2))
            kernel += 0.06 * np.exp(-((KX - 2) ** 2 + (KY - 1) ** 2) / 3.0)
            if phase:
                kernel = np.zeros_like(kernel)
            title = "Analytic reference kernel (demo)"
        self.kernel.paint(kernel, M, keep, title, phase)

    def _rebuild_kernel_combos(self):
        for cb in (self.cmb_layer, self.cmb_in, self.cmb_out):
            cb.blockSignals(True)
            cb.clear()
        if self.model is not None:
            for i in range(self.model.n_layers):
                self.cmb_layer.addItem(f"SpectralConv2d #{i}")
            for i in range(self.model.width):
                self.cmb_in.addItem(str(i))
                self.cmb_out.addItem(str(i))
        for cb in (self.cmb_layer, self.cmb_in, self.cmb_out):
            cb.blockSignals(False)

    # ------------------------------------------------------------- training

    def _start_training(self):
        if not HAS_TORCH or (self.worker and self.worker.isRunning()):
            return
        cfg = dict(
            epochs=self.spin_epochs.value(), width=self.spin_width.value(),
            modes=self.spin_modes.value(), layers=self.spin_layers.value(),
            train_n=self.spin_train_n.value(), batch=self.spin_batch.value(),
            lr=self.spin_lr.value(), device=self.cmb_device.currentText(),
            train_size=128, val_size=32, seed=123,
        )
        self.history.clear()
        self.loss.paint([])
        self.log.clear()
        self.worker = TrainingWorker(cfg, self.op)
        self.worker.progress.connect(self._on_progress)
        self.worker.snapshot.connect(self._on_snapshot)
        self.worker.log.connect(lambda s: self.log.appendPlainText(s))
        self.worker.done.connect(self._on_training_done)
        self.btn_train.setEnabled(False)
        self.btn_stop.setEnabled(True)
        self.progress.setValue(0)
        self.worker.start()

    def _on_progress(self, epoch, train, val):
        self.history.append((epoch, max(train, 1e-9), max(val, 1e-9)))
        self.loss.paint(self.history)
        self.progress.setValue(int(100 * epoch / max(self.spin_epochs.value(), 1)))

    def _on_snapshot(self, model):
        if self._closing:
            return
        self.model = model
        self.model_cfg = getattr(model, "_fno_cfg", None)
        self._prune_cache.clear()
        self._cache.clear()
        M = model.modes
        self.slider.blockSignals(True)
        self.slider.setRange(1, M)
        self.slider.setValue(min(self.keep, M))
        self.keep = self.slider.value()
        self.slider.blockSignals(False)
        self._rebuild_kernel_combos()
        self.refresh()

    def _on_training_done(self, status):
        self.btn_train.setEnabled(HAS_TORCH)
        self.btn_stop.setEnabled(False)
        self.log.appendPlainText(f"Training {status}.")

    def _reset_model(self):
        if self.worker and self.worker.isRunning():
            self.worker.request_stop()
            return
        self.model = None
        self.model_cfg = None
        self._cache.clear()
        self._prune_cache.clear()
        self.slider.blockSignals(True)
        self.slider.setRange(1, 16)
        self.slider.blockSignals(False)
        self._rebuild_kernel_combos()
        self.history.clear()
        self.loss.paint([])
        self.refresh()
        self.log.appendPlainText("Reset to synthetic demo.")

    # --------------------------------------------------------------- extras

    def _toggle_sweep(self, on):
        if on:
            self._sweep_timer.start()
        else:
            self._sweep_timer.stop()

    def _sweep_step(self):
        v = self.slider.value()
        hi = self.slider.maximum()
        if v >= hi:
            self._sweep_dir = -1
        elif v <= 1:
            self._sweep_dir = 1
        self.slider.setValue(v + self._sweep_dir)

    def _toggle_theme(self):
        self.dark = not self.dark
        self._apply_theme()

    def _apply_theme(self):
        QApplication.instance().setStyleSheet(DARK_QSS if self.dark else LIGHT_QSS)
        for canvas in (self.field, self.slices, self.spectrum, self.hist,
                       self.loss, self.kernel):
            canvas.restyle(self.dark)

    def _save_path(self, suffix: str, filter_str: str) -> str | None:
        path, _ = QFileDialog.getSaveFileName(self, "Save", f"fno_{suffix}{suffix and '.' + suffix}", filter_str)
        return path or None

    def _export_png(self):
        path, _ = QFileDialog.getSaveFileName(self, "Export figure", "fno_field.png", "PNG (*.png)")
        if path:
            self.field.fig.savefig(path, dpi=200, bbox_inches="tight",
                                   facecolor=self.field.fig.get_facecolor())
            self.statusBar().showMessage(f"Saved {path}", 4000)

    def _export_npz(self):
        path, _ = QFileDialog.getSaveFileName(self, "Export fields", "fno_fields.npz", "NPZ (*.npz)")
        if path:
            np.savez(
                path, a=self.sample.a, u=self.sample.u, pred=self.pred,
                seed=self.sample_index, resolution=self.resolution, modes=self.keep,
                metrics=json.dumps(metrics(self.sample.u, self.pred, self.keep)),
            )
            self.statusBar().showMessage(f"Saved {path}", 4000)

    def _export_csv(self):
        path, _ = QFileDialog.getSaveFileName(self, "Export slice", "fno_slice.csv", "CSV (*.csv)")
        if path:
            n = self.resolution
            row = n // 2 if self.cursor is None else self.cursor[1]
            x = np.linspace(0, 1, n, endpoint=False)
            data = np.column_stack([x, self.sample.a[row], self.sample.u[row], self.pred[row]])
            np.savetxt(path, data, delimiter=",", fmt="%.8f",
                       header="x,input,truth,pred", comments="")
            self.statusBar().showMessage(f"Saved {path}", 4000)

    def _export_model(self):
        if self.model is None:
            QMessageBox.information(self, "No model", "Train a model first.")
            return
        path, _ = QFileDialog.getSaveFileName(self, "Save weights", "fno.pt", "Torch (*.pt)")
        if path:
            torch.save({"state_dict": self.model.state_dict(), "cfg": self.model_cfg}, path)

    def _import_model(self):
        if not HAS_TORCH:
            return
        path, _ = QFileDialog.getSaveFileName(self, "Load weights", "", "Torch (*.pt)")
        if not path:
            return
        try:
            blob = torch.load(path, map_location="cpu", weights_only=True)
            cfg = blob.get("cfg") or self.model_cfg or dict(
                width=self.spin_width.value(), modes=self.spin_modes.value(),
                layers=self.spin_layers.value())
            model = FNO2d(**cfg)
            model.load_state_dict(blob["state_dict"])
            model.eval()
            model._fno_cfg = cfg
            self._on_snapshot(model)
            self.log.appendPlainText(f"Loaded {path}")
        except Exception as exc:
            QMessageBox.critical(self, "Load failed", str(exc))

    def _about(self):
        QMessageBox.information(self, "About",
            "FNO Studio\n\n"
            "Interactive Fourier Neural Operator workbench.\n"
            "Space: sweep modes · R: new sample · G: quad view · "
            "D: theme · S: export PNG\n\n"
            "Click the 2D field to probe cross-sections.")

    # -------------------------------------------------------------- lifecycle

    def closeEvent(self, event):
        self._closing = True
        self._sweep_timer.stop()
        self.settings.setValue("dark", self.dark)
        self.settings.setValue("sample", self.sample_index)
        self.settings.setValue("resolution", self.resolution)
        self.settings.setValue("keep", self.keep)
        self.settings.setValue("cmap", self.cmb_cmap.currentText())
        self.settings.setValue("var", self.cmb_var.currentIndex())
        self.settings.setValue("quad", self.chk_quad.isChecked())
        if self.worker and self.worker.isRunning():
            self.worker.request_stop()
            if not self.worker.wait(6000):
                self.worker.terminate()
                self.worker.wait()
        event.accept()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("FNO Studio")
    app.setOrganizationName("FNOStudio")
    window = MainWindow()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()